# =========================================================
# WEDMATE Environment Configuration (.env.local)
# =========================================================

# Supabase Configuration
# Obtain these from your Supabase project dashboard (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend Email Configuration (Optional)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM_ADDRESS=notifications@wedmate.id

# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Note: If NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are not configured,
# WEDMATE automatically operates in Graceful Demo Mode using local storage mock DB!
